# ── Cursus · plantilla de entorno ─────────────────────────────────────
# Dev local:  copia a `.env` y deja los valores tal cual (puertos altos en
#             docker-compose.dev.yml: pg 5433, redis 6380).
# Prod Dokploy (https://cursus.empovaro.com): copia el bloque PROD a las
#             Environment Variables de Dokploy y rellena los secretos.
#             Nunca commitees secretos reales: `.env` y `.env.production`
#             están en .gitignore.

# ── Base de datos ─────────────────────────────────────────────────────
# Dev:
DATABASE_URL=postgresql://app:changeme@localhost:5432/app
# Prod (interno Dokploy, el host lo da Dokploy):
# DATABASE_URL=postgresql://app:${POSTGRES_PASSWORD}@db:5432/app
POSTGRES_PASSWORD=changeme

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Prod (con password de Dokploy):
# REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379

# ── Auth.js (OAuth login) ─────────────────────────────────────────────
# Genera uno nuevo por entorno:  openssl rand -base64 32
AUTH_SECRET=changeme-openssl-rand-base64-32
# Login con GitHub (OAuth App, NO la GitHub App de issues↔PRs; son dos
# apps distintas con client id/secret propios):
#   Settings → Developer settings → OAuth Apps → New OAuth App
#   Callback prod: https://cursus.empovaro.com/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Login con Google (https://console.cloud.google.com → Credenciales OAuth):
#   Callback prod: https://cursus.empovaro.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── URLs ──────────────────────────────────────────────────────────────
# Dev:
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Prod:
# NEXTAUTH_URL=https://cursus.empovaro.com
# NEXT_PUBLIC_APP_URL=https://cursus.empovaro.com

# ── Puerto host (solo compose) ────────────────────────────────────────
# Local: 3000. Dokploy: el 3000 lo ocupa Dokploy → pon 3010 (o libre).
WEB_PORT=3000

# ── MCP (servidor propio) ─────────────────────────────────────────────
# Token de un cliente local (opencode.jsonc → cursus-local). En prod es
# secreto de servidor: genera con  openssl rand -hex 32  y NO lo publiques.
# Los tokens por workspace se crean con:  bun src/mcp/mint.ts <slug> <nombre>
CURSUS_MCP_TOKEN=

# ── GitHub App estilo Linear (issues ↔ PRs) ───────────────────────────
# Ver guía paso a paso en docs/github-app.md. Resumen:
#   1. github.com → Settings → Developer settings → GitHub Apps → New
#   2. Webhook URL prod: https://cursus.empovaro.com/api/webhooks/github
#   3. Instala la App en tu org/usuario y conecta el workspace
#      (tabla github_installations).
# OJO: esto NO es el OAuth de login de arriba; es una app aparte.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Clave privada .pem de la App, en UNA línea con \n literales:
#   awk 'NF {sub(/\r/, ""); printf "%s\\n", $0;}' clave-privada.pem
GITHUB_APP_PRIVATE_KEY=
# Secreto del webhook (lo defines al crear la App; verifica la firma HMAC):
# Genera con:  openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# Al hacer merge de un PR vinculado, pasar el issue a Done (como Linear):
GITHUB_AUTO_CLOSE_ON_MERGE=true

# Solo Docker/entrypoint (las .sql viven en /app/migrations dentro de la imagen):
# MIGRATIONS_DIR=/app/migrations
